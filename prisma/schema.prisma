generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model HeroSection {
  id        String   @id @default(uuid())
  title     String
  subtitle  String
  imageUrl  String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Category {
  id        String   @id @default(uuid())
  name      String
  imageUrl  String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  products  Product[]
}

model Product {
  id              String         @id @default(uuid())
  name            String
  price           Decimal        @db.Decimal(10,2)  // ✅ MySQL decimal fix
  onSale          Boolean        @default(false)    // Whether product is on sale
  salePercentage  Int?           // Sale percentage (1-99)
  imageUrl        String         // Main product image
  productType     String         @default("bag")    // Product type: "bag" or "shoes"
  category        Category?      @relation(fields: [categoryId], references: [id])
  categoryId      String?
  size            String?        // Made optional since we use size variants now
  description     String         @db.LongText  // ✅ Fix for MySQL Text
  featured        Boolean        @default(false)
  stock           Int            @default(5)
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt
  colorVariants   ColorVariant[]
  sizeVariants    SizeVariant[]  // Keeping for backward compatibility
  // Legacy fields - keeping for backward compatibility during migration
  color           String?        // Will be deprecated - made optional
  images          ProductImage[] // Will be deprecated
}

model ColorVariant {
  id           String                @id @default(uuid())
  color        String
  colorHex     String?               // Optional hex color code for custom colors
  stock        Int                   @default(0)
  productId    String
  product      Product               @relation(fields: [productId], references: [id], onDelete: Cascade)
  images       ColorVariantImage[]
  sizeVariants ColorSizeVariant[]    // Each color has its own size variants
  createdAt    DateTime              @default(now())
  updatedAt    DateTime              @updatedAt

  @@unique([productId, color])
}

model ColorVariantImage {
  id              String       @id @default(uuid())
  url             String
  colorVariantId  String
  colorVariant    ColorVariant @relation(fields: [colorVariantId], references: [id], onDelete: Cascade)
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt
}

model ColorSizeVariant {
  id             String       @id @default(uuid())
  size           String       // MINI, SMALL, MEDIUM, LARGE
  stock          Int          @default(0)
  price          Decimal?     @db.Decimal(10,2) // Optional price override for this size in this color
  colorVariantId String
  colorVariant   ColorVariant @relation(fields: [colorVariantId], references: [id], onDelete: Cascade)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@unique([colorVariantId, size])
}

// Keeping the old SizeVariant model for backward compatibility during migration
model SizeVariant {
  id        String   @id @default(uuid())
  size      String   // MINI, SMALL, MEDIUM, LARGE
  stock     Int      @default(0)
  price     Decimal? @db.Decimal(10,2) // Optional price override per size
  productId String
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([productId, size])
}

// Legacy model - keeping for backward compatibility
model ProductImage {
  id        String   @id @default(uuid())
  url       String
  product   Product  @relation(fields: [productId], references: [id])
  productId String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

